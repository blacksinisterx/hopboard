{
  "name": "Hopboard",
  "short_name": "Hopboard",
  "description": "Hop your clipboard, photos and files between phone and laptop. End-to-end encrypted, no account.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#FFF4DE",
  "theme_color": "#FFD23F",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["image/*", "application/pdf", "text/*", "application/zip"] }]
    }
  }
}
